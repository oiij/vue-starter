{
  "name": "vue-starter",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "vue-starter",
  "author": "oiij",
  "license": "MIT",
  "homepage": "https://github.com/oiij/vue-starter",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "update:deps": "taze -w && pnpm i",
    "type:check": "vue-tsc --noEmit",
    "preview": "vite preview",
    "cz": "czg",
    "commit": "git pull && git add -A && pnpm cz && git push",
    "pull": "git checkout -- . && git pull origin main",
    "release": "pnpm pull && pnpm build",
    "awe": "pnpx are-we-esm",
    "nmi": "pnpx node-modules-inspector",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "npx simple-git-hooks"
  },
  "dependencies": {
    "@oiij/auto-i18n": "^0.0.8",
    "@oiij/auto-router": "^0.0.9",
    "@oiij/directives": "^0.0.19",
    "@oiij/naive-ui": "^0.0.82",
    "@oiij/use": "^0.0.51",
    "@oiij/utils": "^0.0.8",
    "@unhead/vue": "3.2.3",
    "@unocss/reset": "66.7.5",
    "@vueuse/core": "^14.4.0",
    "await-to-js": "^3.0.0",
    "axios": "^1.19.0",
    "colord": "^2.9.3",
    "es-toolkit": "^1.50.0",
    "mixte": "3.6.1",
    "nanoid": "^6.0.0",
    "notivue": "^2.4.5",
    "nprogress": "^0.2.0",
    "pinia": "^4.0.2",
    "pinia-plugin-persistedstate": "^4.7.1",
    "pinia-undo": "^0.2.4",
    "vue": "^3.5.40",
    "vue-hooks-plus": "2.4.3",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@dxup/unimport": "^0.1.2",
    "@iconify-json/mage": "^1.2.4",
    "@intlify/unplugin-vue-i18n": "^11.2.4",
    "@oiij/tsconfig": "^0.0.4",
    "@oiij/unocss-preset": "^0.0.1",
    "@plugin-web-update-notification/vite": "^2.1.3",
    "@shikijs/markdown-exit": "^4.4.1",
    "@types/node": "^26.1.2",
    "@types/nprogress": "^0.2.3",
    "@unocss/eslint-config": "66.7.5",
    "@unocss/eslint-plugin": "66.7.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/ui": "^4.1.10",
    "@vue-hooks-plus/resolvers": "^1.3.0",
    "@vue/test-utils": "^2.4.11",
    "commitlint": "^21.2.1",
    "cz-git": "^1.13.1",
    "czg": "^1.13.1",
    "eslint": "^10.8.0",
    "eslint-plugin-format": "^2.0.1",
    "jsdom": "^30.0.1",
    "less": "^4.8.1",
    "lint-staged": "^17.3.0",
    "markdown-it-link-attributes": "^4.0.1",
    "naive-ui": "^2.44.1",
    "nitro": "3.0.260610-beta",
    "postcss": "^8.5.25",
    "postcss-preset-env": "^11.3.2",
    "simple-git-hooks": "^2.13.1",
    "taze": "^19.17.0",
    "typescript": "^6.0.3",
    "unocss": "66.7.5",
    "unocss-preset-animatecss": "^0.0.2",
    "unocss-preset-animations": "^1.3.0",
    "unocss-preset-extra": "^1.0.0",
    "unocss-preset-scrollbar": "^4.0.0",
    "unocss-preset-theme": "^0.14.1",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-info": "^1.3.2",
    "unplugin-svg-component": "^0.12.6",
    "unplugin-turbo-console": "^2.3.3",
    "unplugin-vue": "^7.2.0",
    "unplugin-vue-components": "^32.1.0",
    "unplugin-vue-markdown": "^32.0.0",
    "vfonts": "^0.0.3",
    "vite": "^8.2.0",
    "vite-bundle-analyzer": "^1.3.9",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-svg-sfc": "^2.2.0",
    "vite-plugin-url-copy": "^1.1.4",
    "vite-plugin-version-mark": "^0.2.2",
    "vite-plugin-virtual": "^0.5.0",
    "vite-plugin-vue-devtools": "8.2.1",
    "vite-plugin-vue-layouts": "^0.11.0",
    "vite-plugin-webfont-dl": "^3.12.0",
    "vitest": "^4.1.10",
    "vue-router-better-scroller": "^0.0.0",
    "vue-tsc": "^3.3.9"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged && pnpm type:check"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "pnpm lint:fix"
    ]
  }
}
